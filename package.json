{
  "name": "@anandman/courier",
  "version": "1.0.0",
  "description": "Your mail, calendar, contacts and tasks over JMAP and DAV. MCP server.",
  "keywords": [
    "caldav",
    "calendar",
    "claude",
    "cli",
    "contacts",
    "email",
    "fastmail",
    "gemini",
    "jmap",
    "mcp",
    "model-context-protocol",
    "oauth"
  ],
  "homepage": "https://github.com/anandman/courier#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anandman/courier.git"
  },
  "bugs": {
    "url": "https://github.com/anandman/courier/issues"
  },
  "license": "MIT",
  "author": "Anand Mandapati",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "courier": "dist/cli/bin.js",
    "courier-mcp": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "docs",
    "CHANGES.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
